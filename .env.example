# Optional. If unset, the Analyzer agent falls back to a deterministic heuristic
# so the whole pipeline still runs end-to-end offline.
ANTHROPIC_API_KEY=

# Hard ceiling enforced by the guardrail layer, regardless of what the analyzer proposes.
MAX_DISCOUNT_PCT=15

# Risk score band (0-100) treated as "ambiguous" -> routed to the LLM analyzer.
AMBIGUOUS_BAND_LOW=40
AMBIGUOUS_BAND_HIGH=70
